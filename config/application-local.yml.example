# 이 파일을 같은 디렉토리의 application-local.yml 로 복사해서 각자 로컬 값으로 채운다.
#
#   cp config/application-local.yml.example config/application-local.yml
#
# config/ 에 두는 이유:
#   Spring Boot 는 프로젝트 루트의 config/ 를 설정 탐색 경로에 포함하므로
#   여기 두면 로컬 실행 시 자동으로 읽힌다. 반면 src/main/resources 에 두면
#   jar 안으로 패키징돼서 로컬 DB 자격증명이 배포 산출물에 실린다.
#
# config/application-local.yml 은 .gitignore 에 있으므로 커밋되지 않는다.
#
# 최소 앱 단계에서는 DB 설정이 필요 없다. JPA 를 붙일 때 주석을 푼다.

#spring:
#  datasource:
#    # connectionTimeZone 은 Connector/J 8.0.23 부터의 정식 이름이다.
#    # 예전 가이드에 나오는 serverTimezone 은 현재 별칭으로만 유효하다.
#    url: jdbc:mysql://localhost:3306/hackathon?connectionTimeZone=Asia/Seoul&characterEncoding=UTF-8
#    username: hackathon
#    password: 1234
#  jpa:
#    hibernate:
#      ddl-auto: update
#    show-sql: true
